pragma solidity 0.8.30;
import {MarketForkFixture} from "./MarketForkFixture.sol";
import {AttestedWorkForkFixture} from "./AttestedWorkForkFixture.sol";
import {AttestedAgentRounds as Rounds} from "../../src/AttestedAgentRounds.sol";
import {RestrictedMarketReserveReceiver as Receiver} from "../../src/RestrictedMarketReserveReceiver.sol";
import {IV4Market} from "../../src/market/IV4Market.sol";
import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import {FinancierFeeRouter} from "../../src/FinancierFeeRouter.sol";
import {V4AttackActor} from "../../test/helpers/Task23Base.sol";
import {Math} from "@openzeppelin/contracts/utils/math/Math.sol";

/// Exact approved economics. Real official runtime/storage; synthetic test authority/evidence,
/// injected IMD and impersonated factory/bootstrap/settlement callers ONLY on the local fork.
contract Task25LaunchForkTest is MarketForkFixture, AttestedWorkForkFixture {
    function testOfficialFeeHandoffRoutesOnlyCanonicalWorkAndBurn() public {
        FinancierFeeRouter router = new FinancierFeeRouter(receiver);
        // Genesis buys produce IMD fees only. Sell real earned LOCAL FINCR to exercise
        // the other currency; no invented fee balance or protected-reserve confiscation.
        vm.warp(block.timestamp + 3600);
        vm.prank(address(101));
        miner.claimFincr();
        V4AttackActor trader = new V4AttackActor(market.MANAGER(), market.key());
        vm.prank(address(101));
        token.transfer(address(trader), 1 ether);
        uint160 spot = market.spot();
        bool direction = !market.imdIs0();
        trader.trade(direction, 1 ether, direction ? spot - spot / 10 : spot + spot / 10);
        uint256 principal = uint256(IV4Market(market.MANAGER()).extsload(initialPositionSlot));
        vm.expectRevert();
        vm.prank(address(999));
        FACTORY.setRequester(number, address(router));
        FACTORY.setRequester(number, address(router)); // Real official current requester only.
        (,,, address requester) = FACTORY.positionOf(number);
        assertEq(requester, address(router));
        router.collect(); // Real swap fees generated by automatic genesis buyback/LP.
        IERC20 imd = IERC20(miner.WORK_ASSET());
        uint256 imdFees = imd.balanceOf(address(router));
        uint256 fincrFees = token.balanceOf(address(router));
        assertGt(imdFees, 0);
        assertGt(fincrFees, 0);
        uint256 work = miner.workBudget();
        uint256 supply = token.totalSupply();
        uint256 custody = token.balanceOf(address(miner));
        uint256 operations = imd.balanceOf(operationsEOA());
        router.routeImd();
        router.burnFincr();
        assertEq(miner.workBudget() - work, imdFees);
        assertEq(miner.totalWorkFunding(), imdFees);
        assertEq(router.totalImdRouted(), imdFees);
        assertEq(router.totalFincrBurned(), fincrFees);
        assertEq(token.totalSupply(), supply - fincrFees);
        assertEq(imd.balanceOf(operationsEOA()), operations);
        assertEq(imd.allowance(address(router), address(miner)), 0);
        assertEq(token.balanceOf(address(miner)), custody);
        assertEq(uint256(IV4Market(market.MANAGER()).extsload(initialPositionSlot)), principal);
        assertEq(miner.totalBidVolume() + miner.totalWorkFunding(), miner.totalImdPaid() + miner.imdLiability());
        assertEq(imd.balanceOf(address(miner)), miner.imdLiability());
        vm.expectRevert();
        FACTORY.setRequester(number, address(this)); // Original requester lost the role.
        router.routeImd(); // Empty/repeated calls cannot manufacture funding or burns.
        router.burnFincr();
        assertEq(miner.totalWorkFunding(), imdFees);
        emit log_named_address("LOCAL immutable fee router", address(router));
        emit log_named_bytes32("LOCAL fee router runtime", address(router).codehash);
        emit log_named_uint("Actual requester IMD fees funding work", imdFees);
        emit log_named_uint("Actual requester FINCR fees burned", fincrFees);
    }

    function testFeeHandoffDoesNotMovePreviouslyOwedFees() public {
        address imd = miner.WORK_ASSET();
        vm.mockCallRevert(
            imd, abi.encodeWithSelector(IERC20.transfer.selector, address(this)), "LOCAL old recipient failure"
        );
        FACTORY.claimFees(number);
        uint256 owed = FACTORY.owed(address(this), imd);
        assertGt(owed, 0);
        vm.clearMockedCalls();
        FinancierFeeRouter router = new FinancierFeeRouter(receiver);
        FACTORY.setRequester(number, address(router));
        assertEq(FACTORY.owed(address(this), imd), owed);
        assertEq(FACTORY.owed(address(router), imd), 0);
        router.collect();
        assertEq(FACTORY.owed(address(this), imd), owed);
    }

    function testRouterRejectsMissingCanonicalSelectionAndRuntimeDrift() public {
        FinancierFeeRouter router = new FinancierFeeRouter(receiver);
        vm.mockCall(address(receiver), abi.encodeWithSelector(receiver.bootstrapped.selector), abi.encode(false));
        vm.expectRevert(FinancierFeeRouter.Unauthenticated.selector);
        router.collect();
        vm.expectRevert(FinancierFeeRouter.Unauthenticated.selector);
        router.routeImd();
        vm.clearMockedCalls();
        vm.etch(address(receiver), hex"00");
        vm.expectRevert(FinancierFeeRouter.Unauthenticated.selector);
        router.burnFincr();
    }

    function testFeeRouterRejectsWrongChainAndFactoryRuntime() public {
        vm.chainId(1);
        vm.expectRevert(FinancierFeeRouter.Unauthenticated.selector);
        new FinancierFeeRouter(receiver);
        vm.chainId(4663);
        vm.etch(address(FACTORY), hex"00");
        vm.expectRevert(FinancierFeeRouter.Unauthenticated.selector);
        new FinancierFeeRouter(receiver);
    }

    function openingQuote() internal pure override returns (uint256) {
        return 10 ether;
    }

    function auctionFloor() internal pure override returns (uint256) {
        return 0.5 ether;
    }

    function operationsEOA() internal pure override returns (address) {
        return 0x74421cdb9e6ad159358c4af7C59CFAE472A0541e;
    }

    function beforeBootstrap() internal override {
        bytes32[] memory bodies = new bytes32[](1);
        bodies[0] = keccak256(requestBody());
        Rounds r = miner.agentRounds();
        vm.prank(TEST_SETTLER);
        r.precommitRound(0, bodies, keccak256("SYNTHETIC FINANCIER accepted-work/owner policy"));
    }

    function afterArm() internal override {
        uint256 square = uint256(beforeFirstBid) * beforeFirstBid;
        uint256 cap = market.imdIs0()
            ? Math.mulDiv(1e27, uint256(1) << 192, square)
            : Math.mulDiv(1e27, square, uint256(1) << 192);
        assertApproxEqAbs(cap, 2500 ether, 1); // Recorded official UI-default initial ratio.
        emit log_named_uint("Initial pool full-supply cap IMD rounded base units", cap);
        assertEq(miner.currentPrice(), 10 ether);
        assertEq(miner.auctionStart(), block.timestamp);
        vm.warp(block.timestamp + 1800);
        assertEq(miner.currentPrice(), 5.25 ether);
        assertEq(miner.genesis(), 0);
        assertEq(miner.agentReserved(), 0);
        emit log_named_uint("Approved genesis opening IMD", 10 ether);
        emit log_named_uint("Approved all-epoch floor IMD", 0.5 ether);
        emit log_named_uint("Genesis quote after 30 minutes IMD", miner.currentPrice());
    }

    function testTask25ApprovedLaunchEqualSharesAndFailureIsolation() public {
        Rounds r = miner.agentRounds();
        address ops = operationsEOA();
        IERC20 imd = IERC20(miner.WORK_ASSET());
        emit log_named_address("LOCAL token", address(token));
        emit log_named_address("LOCAL miner", address(miner));
        emit log_named_address("LOCAL receiver", address(receiver));
        emit log_named_address("Official factory-created LOCAL swarm distributor", distributor);
        emit log_named_bytes("LOCAL miner constructor arguments", receiver.minerArguments(address(token)));
        (Receiver.Pins memory pins, Receiver.Settings memory settings) = receiver.configuration();
        emit log_named_bytes("LOCAL receiver constructor arguments", abi.encode(pins, settings, BOOTSTRAP));
        emit log_named_bytes32("LOCAL miner runtime", address(miner).codehash);
        emit log_named_bytes32("LOCAL receiver runtime", address(receiver).codehash);
        emit log_named_bytes32("LOCAL rounds runtime", address(r).codehash);
        emit log_named_bytes32("LOCAL market runtime", address(market).codehash);
        assertEq(token.balanceOf(distributor), 100_000_000 ether);
        assertEq(token.balanceOf(address(miner)), 400_000_000 ether);
        assertEq(miner.initialSupply(), 1_000_000_000 ether);
        assertEq(miner.workBudget(), 4.4625 ether); // 85% of actual 5.25 IMD first bid.
        assertEq(miner.resetPrice(), 10 ether); // Fixed opening, independent of actual paid quote.
        assertEq(miner.totalBuybackSpent(), 0.1 ether); // Immutable per-attempt cap.
        assertGt(miner.totalFincrBurned(), 0);
        assertGt(market.totalLiquidity(), 0);
        uint256 outgoingBefore = imd.balanceOf(address(101));
        uint256 opsBefore = imd.balanceOf(ops);
        bytes32 job = requestAndBind(miner); // Real LOCAL Intake spend; synthetic job binding.
        nextBid(2_000_000); // One hour later, 0.5 IMD persistent floor.
        assertEq(imd.balanceOf(address(101)) - outgoingBefore, 0.4 ether);
        assertEq(imd.balanceOf(ops) - opsBefore, 0.01875 ether);
        assertEq(miner.workBudget(), 4.4625 ether - 0.5 ether + 0.025 ether);
        vm.prank(address(101));
        uint256 financierPaid = miner.claimFincr();
        assertGt(financierPaid, 0);
        vm.prank(address(999));
        vm.expectRevert(Rounds.NoClaim.selector);
        r.claim(0);
        vm.warp(r.context(0).end);
        settleAndClaim(miner, job, 3); // SYNTHETIC authority/owners/complete accepted set.
        uint256 budget = miner.agentAllocation(0, 1 days);
        assertEq(r.totalPaid(), budget / 3 * 3);
        assertEq(r.totalQuarantined(), budget % 3);
        assertEq(miner.totalAgentPaid(), budget / 3 * 3);
        for (uint256 i; i < 3; i++) {
            assertEq(token.balanceOf(address(uint160(300 + i))), budget / 3);
            vm.prank(address(uint160(300 + i)));
            vm.expectRevert(Rounds.NoClaim.selector);
            r.claim(0);
        }
        vm.prank(address(999));
        vm.expectRevert();
        r.precommitRound(2, new bytes32[](1), keccak256("unauthorized"));
        uint256 spent = miner.totalBuybackSpent();
        vm.mockCallRevert(market.MANAGER(), abi.encodePacked(IV4Market.swap.selector), "SYNTHETIC failed swap");
        nextBid(2_000_000);
        assertEq(miner.totalBuybackSpent(), spent);
        vm.clearMockedCalls();
        uint256 deferred = miner.buybackBudget();
        nextBid(450_000);
        assertEq(miner.totalBuybackSpent(), spent);
        assertEq(miner.buybackBudget(), deferred + 0.0375 ether);
        nextBid(2_000_000);
        assertEq(miner.totalBuybackSpent() - spent, 0.1 ether);
        assertEq(token.totalSupply() + miner.totalFincrBurned(), 1e27);
        assertEq(token.balanceOf(address(miner)) + miner.totalFincrPaid() + miner.totalAgentPaid(), 4e26);
        assertEq(imd.balanceOf(address(miner)), miner.imdLiability());
        assertEq(miner.totalBidVolume(), miner.totalImdPaid() + miner.imdLiability());
        assertEq(miner.buybackBudget() + miner.totalBuybackSpent(), 5.25 ether * 750 / 10000 + 4 * 0.0375 ether);
        emit log_named_uint("Exact mandatory launch swarm FINCR", token.balanceOf(distributor));
        emit log_named_uint("Synthetic equal agent count", 3);
        emit log_named_uint("Synthetic equal FINCR share", budget / 3);
        emit log_named_uint("Quarantined FINCR rounding", budget % 3);
        emit log_named_uint("Financier FINCR claimed", financierPaid);
        emit log_named_uint("Actual supply burn FINCR", miner.totalFincrBurned());
        emit log_named_uint("Permanent supplemental LP units", market.totalLiquidity());
        emit log_named_uint("Remaining protected FINCR custody", miner.requiredFincrCustody());
        emit log_named_uint("Deferred buyback IMD", miner.buybackBudget());
        emit log_named_uint("Deferred LP IMD", miner.liquidityBudget());
    }

    /// Actual official Intake runtime; LOCAL synthetic scoped authority, no accepted job/set.
    /// Purchasing work is not evidence that any agent has earned the protected FINCR stream.
    function testTask26ScopedWorkPurchaseWithoutAgentSettlementPreservesIndependentMining() public {
        Rounds r = miner.agentRounds();
        uint256 workBefore = miner.workBudget();
        vm.prank(address(999));
        vm.expectRevert(bytes4(keccak256("Unauthorized()")));
        miner.dispatchWork(0, requestBody());
        vm.prank(TEST_SETTLER);
        bytes32 request = miner.dispatchWork(0, requestBody());
        assertTrue(request != 0);
        (uint256 roundPlusOne, bytes32 bodyHash, uint256 requestedAt) = miner.workRequests(request);
        assertEq(roundPlusOne, 1);
        assertEq(bodyHash, keccak256(requestBody()));
        assertEq(requestedAt, block.timestamp);
        assertEq(workBefore - miner.workBudget(), 0.5 ether);
        assertEq(miner.totalWorkSpent(), 0.5 ether);
        assertEq(r.totalPaid(), 0);
        assertEq(miner.totalAgentPaid(), 0);
        vm.prank(address(999));
        vm.expectRevert(Rounds.NoClaim.selector);
        r.claim(0);
        nextBid(2_000_000);
        vm.prank(address(101));
        uint256 financierPaid = miner.claimFincr();
        assertGt(financierPaid, 0);
        assertGt(miner.agentReserved(), 0);
        assertEq(miner.totalAgentPaid(), 0);
        assertEq(token.balanceOf(address(miner)) + miner.totalFincrPaid(), 4e26);
        assertEq(miner.totalBidVolume() + miner.totalWorkFunding(), miner.totalImdPaid() + miner.imdLiability());
        assertEq(IERC20(miner.WORK_ASSET()).balanceOf(address(miner)), miner.imdLiability());
        emit log_named_bytes32("LOCAL actual Intake request with NO accepted agent proof", request);
        emit log_named_uint("Actual LOCAL scoped work payment IMD", miner.totalWorkSpent());
        emit log_named_uint("Protected agent FINCR remains unpaid", miner.agentReserved());
        emit log_named_uint("Independent financier claim while agent settlement blocked", financierPaid);
    }
}
